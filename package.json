{
  "name": "striply",
  "version": "2.5.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/build-pwa.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "skills:validate": "node scripts/validate-skills.mjs",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "test:cloud": "vitest run tests/cloud.test.ts tests/rls.test.ts",
    "cloud:cleanup": "node --env-file=.env.local scripts/cleanup-cloud.mjs",
    "test:e2e:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:cloud:live": "node --env-file=.env.local scripts/test-cloud-live.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vitest": "^4",
    "yaml": "^2"
  },
  "type": "module"
}
