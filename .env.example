# Local Supabase: supabase status provides these values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public origin used for links; a phone cannot reach your PC through 127.0.0.1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Trusted reverse proxy must overwrite x-forwarded-for before enabling this.
TRUST_PROXY=false
